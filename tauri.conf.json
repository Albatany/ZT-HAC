{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZT-HAC",
  "version": "0.1.0",
  "identifier": "dev.albatany.zthac",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Zero-Trust Host Access Controller", "width": 1100, "height": 720, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
